---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const fmtDate = (iso: string) =>
  new Date(iso + "T12:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// Most recent race first (ISO date strings sort chronologically).
const races = (await getCollection("races")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout
  title="Running"
  description="Races I've run, with distances and finish times."
>
  <header class="page-head">
    <h1>Running</h1>
    <p class="muted">
      Races I've run, with distances and finish times.
      <span class="pr-key">PR</span> marks a personal record.
    </p>
  </header>

  <div class="table-wrap">
    <table class="races">
      <thead>
        <tr>
          <th>Date</th>
          <th>Race</th>
          <th>Distance</th>
          <th class="num">Time</th>
        </tr>
      </thead>
      <tbody>
        {
          races.map((r) => (
            <tr>
              <td class="date muted">{fmtDate(r.data.date)}</td>
              <td class="race">
                <span class="name">{r.data.race}</span>
                {r.data.location && (
                  <span class="loc muted"> · {r.data.location}</span>
                )}
                {r.data.notes && <span class="notes muted">{r.data.notes}</span>}
              </td>
              <td>{r.data.distance}</td>
              <td class="num time">
                {r.data.time}
                {r.data.pr && (
                  <span class="pr" title="Personal record">
                    PR
                  </span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 1.75rem;
  }
  .page-head h1 {
    margin: 0 0 0.35rem;
  }
  .page-head p {
    margin: 0;
  }
  .pr-key,
  .pr {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0.3rem;
    padding: 0.02rem 0.3rem;
    vertical-align: middle;
  }
  .pr-key {
    margin-inline: 0.2rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .races {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .races th,
  .races td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .races th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .races td.race {
    white-space: normal;
  }
  .races .name {
    font-weight: 600;
  }
  .races .notes {
    display: block;
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .races .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .races .time {
    font-weight: 600;
  }
  .races .pr {
    margin-left: 0.4rem;
  }
</style>
